NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=
DB_NAME=school

# Required. No default. Number from 0 to 100. Decimals allowed.
PASS_PERCENTAGE=40

# Required. No default. Format YYYY-YY, second year = first + 1. Example: 2026-27
ACADEMIC_YEAR=2026-27

# Required. At least 16 characters. Signs access tokens.
JWT_SECRET=

# Required. Comma-separated http(s) origins. "*" is rejected.
CORS_ORIGINS=http://localhost:3000

# Optional. Marks writes per user per 10 minutes. Default 60.
MARKS_RATE_LIMIT_MAX=60
